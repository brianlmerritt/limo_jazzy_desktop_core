FROM limo-jazzy-desktop-core:dev
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ros-jazzy-cv-bridge \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/vision-venv
ENV PATH=/opt/vision-venv/bin:$PATH
# CUDA 13 wheels for the installed L4T R39 platform; all application deps stay in Docker.
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cu130
RUN pip install --no-cache-dir numpy==1.26.4 opencv-python==4.11.0.86 ultralytics==8.4.143
ENV YOLO_CONFIG_DIR=/tmp/ultralytics-build NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /opt/models
COPY config/cameras/yolo-models.sha256 /opt/models/SHA256SUMS
RUN mkdir -p /tmp/ultralytics-build && python -c "from ultralytics import YOLO; YOLO('yolo26n-pose.pt'); YOLO('yolo26s-pose.pt')" \
    && sha256sum --check SHA256SUMS
ENV YOLO_CONFIG_DIR=/tmp/ultralytics
COPY src/ros2_hide_and_seek /opt/autonomy-src
RUN bash -c 'source /opt/ros/jazzy/setup.bash; cd /opt; colcon build --base-paths /opt/autonomy-src --build-base /opt/autonomy-build --install-base /opt/autonomy-install'
WORKDIR /workspace
ARG DEV_USER=blm
USER ${DEV_USER}
CMD ["bash"]
