Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 44
    Fixed Frame: limo/odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 100; 110; 120
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Robot and sensor frames
      Enabled: true
      Frame Timeout: 10
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.2
      Frames:
        All Enabled: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Planar lidar
      Enabled: true
      Topic:
        Value: /limo/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color Transformer: FlatColor
      Color: 65; 220; 130
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar point cloud
      Enabled: false
      Topic:
        Value: /limo/point_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 80; 170; 255
      Style: Points
      Size (Pixels): 3
      Value: false
    - Class: rviz_default_plugins/Image
      Name: Front RGB camera
      Enabled: true
      Topic:
        Value: /limo/camera/front/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Transport Hint: raw
      Normalize Range: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth odometry
      Enabled: true
      Topic:
        Value: /limo/odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Keep: 30
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 0.85
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1280
  Height: 900
